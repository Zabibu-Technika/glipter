{
  "name": "Glipter — Edge Sign Language Engine",
  "short_name": "Glipter",
  "description": "Offline-first, on-device sign language conversation. Built for Kenyan Sign Language, ASL, and BSL, with embedded multilingual speech and no cloud dependency.",
  "id": "./",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "minimal-ui"],
  "orientation": "any",
  "background_color": "#f4ecff",
  "theme_color": "#7c3aed",
  "lang": "en",
  "dir": "ltr",
  "categories": ["accessibility", "education", "productivity"],
  "icons": [
    {
      "src": "assets/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "assets/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "assets/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "assets/favicon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    }
  ],
  "shortcuts": [
    {
      "name": "Talk",
      "short_name": "Talk",
      "description": "Open the two-way conversation workspace",
      "url": "./#live",
      "icons": [{ "src": "assets/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Learn handshapes",
      "short_name": "Learn",
      "description": "Browse the alphabet reference",
      "url": "./#learn",
      "icons": [{ "src": "assets/icon-192.png", "sizes": "192x192" }]
    }
  ]
}
